generator client {
    provider = "prisma-client"
    output   = "./generated"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

model Theater {
    id String @id @default(nanoid())

    name    String
    address String

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_At")

    @@map("theaters")
}